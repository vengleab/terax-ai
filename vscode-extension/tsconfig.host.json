{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ],
    "noEmit": true,
    "paths": {}
  },
  "include": [
    "src",
    "shared"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
