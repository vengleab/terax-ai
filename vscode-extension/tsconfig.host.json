{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist/host",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src",
    "shared"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
